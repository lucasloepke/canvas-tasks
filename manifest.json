{
  "manifest_version": 3,
  "name": "Simple Canvas Tasks",
  "version": "1.0.0",
  "description": "Replaces the Canvas dashboard To Do sidebar with tabbed Tasks / Posts / Calendar sections and live due-date countdowns.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Simple Canvas Tasks",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": ["storage"],
  "host_permissions": ["https://*/*"],
  "content_scripts": [
    {
      "matches": ["https://*/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}
